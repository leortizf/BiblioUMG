              "pm.test(\"Estado ACTIVO\", () => pm.expect(p.estado).to.eql(\"ACTIVO\"));",
              "pm.test(\"Resta un ejemplar\", () => pm.expect(p.libro.ejemplares_disponibles).to.eql(Number(pm.collectionVariables.get(\"disponiblesAntes\")) - 1));",
              "pm.test(\"Vence en 7 días\", () => { const d = (new Date(p.fecha_vencimiento) - new Date(p.fecha_entrega)) / 86400000; pm.expect(d).to.eql(7); });"
            ]
          }
