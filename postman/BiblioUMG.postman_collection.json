{
  "info": {
    "name": "BiblioUMG API",
    "description": "Pruebas de API de BiblioUMG. Incluye el flujo completo de un préstamo (solicitar → entregar → renovar → devolver).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Salud de la API",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/salud",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "salud"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contenido: estado ok\", () => pm.expect(pm.response.json().estado).to.eql(\"ok\"));",
              "pm.test(\"Responde en menos de 2 s\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login bibliotecario válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@biblioumg.com\", \"password\": \"Admin12345\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"Esquema: token y usuario\", () => pm.response.to.have.jsonSchema({type:\"object\",required:[\"token\",\"usuario\"],properties:{token:{type:\"string\"},usuario:{type:\"object\",required:[\"id\",\"rol\"]}}}));",
              "pm.test(\"Rol BIBLIOTECARIO\", () => pm.expect(d.usuario.rol).to.eql(\"BIBLIOTECARIO\"));",
              "pm.collectionVariables.set(\"tokenAdmin\", d.token);"
            ]
          }
        }
      ]
    },
