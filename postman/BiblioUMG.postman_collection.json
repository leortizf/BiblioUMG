    {
      "name": "09 Catálogo completo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/libros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
              "const libros = pm.response.json();",
              "pm.test(\"Esquema: lista de libros\", () => pm.response.to.have.jsonSchema({type:\"array\",items:{type:\"object\",required:[\"id\",\"isbn\",\"titulo\",\"ejemplares_totales\",\"ejemplares_disponibles\"]}}));",
              "pm.test(\"Disponibles nunca mayor que totales\", () => libros.forEach(l => pm.expect(l.ejemplares_disponibles).to.be.at.most(l.ejemplares_totales)));",
              "const libre = libros.find(l => l.ejemplares_disponibles > 0);",
              "pm.test(\"Hay un libro disponible\", () => pm.expect(libre).to.exist);",
              "pm.collectionVariables.set(\"libroId\", libre.id);",
              "pm.collectionVariables.set(\"disponiblesAntes\", libre.ejemplares_disponibles);"
            ]
          }
        }
      ]
    },
