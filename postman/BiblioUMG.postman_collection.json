    {
      "name": "04 Registro de estudiante nuevo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Estudiante Newman\", \"carne\": \"{{carne}}\", \"email\": \"{{correo}}\", \"password\": \"Clave2026\", \"tipo\": \"ESTUDIANTE\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.test(\"Esquema de usuario\", () => pm.response.to.have.jsonSchema({type:\"object\",required:[\"id\",\"nombre\",\"carne\",\"email\",\"tipo\",\"rol\",\"multa_pendiente\",\"bloqueado\"]}));",
              "pm.test(\"Nace sin multa ni bloqueo\", () => { pm.expect(d.multa_pendiente).to.eql(0); pm.expect(d.bloqueado).to.eql(false); });",
              "pm.test(\"No expone la contraseña\", () => pm.expect(d).to.not.have.property(\"password_hash\"));",
              "pm.collectionVariables.set(\"usuarioId\", d.id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const n = Date.now().toString().slice(-6);",
              "pm.collectionVariables.set(\"carne\", \"0901-26-\" + n);",
              "pm.collectionVariables.set(\"correo\", \"newman\" + n + \"@prueba.com\");"
            ]
          }
        }
      ]
    },
